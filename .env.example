# =========================================
# DATABASE
# =========================================

# PostgreSQL / Supabase connection string
# Lägg aldrig riktig connection string eller lösenord i denna fil
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE


# =========================================
# PAYLOAD CMS
# =========================================

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE


# =========================================
# SERVER
# =========================================

# Public URL for the application. No trailing slash.
# Production example:
# NEXT_PUBLIC_SERVER_URL=https://www.bonnatosen.se
NEXT_PUBLIC_SERVER_URL=http://localhost:3000


# =========================================
# SHOPIFY
# =========================================

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=YOUR_SHOPIFY_TOKEN_HERE


# =========================================
# EMAIL / SMTP
# =========================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=YOUR_SMTP_PASSWORD_HERE

# Email that receives restaurant booking notifications
RESTAURANT_EMAIL=restaurant@example.com


SUPABASE_S3_ACCESS_KEY=YOUR_SUPABASE_S3_ACCESS_KEY
SUPABASE_S3_SECRET_KEY=YOUR_SUPABASE_S3_SECRET_KEY
SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_BUCKET=media